{
  "name": "portfolio-monorepo",
  "private": true,
  "scripts": {
    "start": "concurrently -n frontend,backend -c blue,green \"npm run start --prefix Frontend\" \"npm run start --prefix portfolio-backend\"",
    "build": "npm --prefix Frontend run build",
    "dev": "npm --prefix Frontend run dev"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "bcryptjs": "^2.4.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.2.3",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.2",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
